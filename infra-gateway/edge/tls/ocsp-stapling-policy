ocsp_stapling:
  enabled: true
  verify: false
resolver:
  nameservers:
    - 8.8.8.8
    - 8.8.4.4
  valid_duration: 300s
  timeout: 5s
cache:
  type: shared
  shared_zone_name: ocsp_cache
  shared_zone_size: 10m
  file_path: /var/cache/nginx/ocsp
responder:
  override_url: ''
  trusted_certificate: ''
